# Copy to .env.local for local development.
# On Vercel, set these under Project Settings → Environment Variables.

# LLM providers — you only need the key(s) for the provider(s) you plan to use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Postgres connection string. Locally: a Docker Postgres (see README).
# On Vercel: the pooled connection string from Neon.
DATABASE_URL=

# Session signing secret — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Canonical base URL the app is served from (locally http://localhost:3000;
# in production https://en.cheeseapps.com). Additional domains the app answers
# on are listed in trustedOrigins in lib/auth.ts.
BETTER_AUTH_URL=http://localhost:3000

# Domain passkeys are bound to (cheeseapps.com in production — passkeys then
# work on any *.cheeseapps.com page, but not the vercel.app URL). Leave unset
# locally to bind to localhost.
PASSKEY_RP_ID=

# Required at sign-up; share with people you invite.
# One or more codes, comma-separated (e.g. code-one,code-two).
SIGNUP_INVITE_CODE=
